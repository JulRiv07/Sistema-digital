# Copia este archivo como  .env  y rellena los valores reales.
# El archivo .env NO se sube a git (está en .gitignore).

# Cadena de conexión de Supabase (la misma que usas en Render)
DATABASE_URL=postgresql://usuario:password@host:5432/postgres

# Clave secreta para firmar los JWT. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
